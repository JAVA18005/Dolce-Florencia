DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/dolce_florencia?schema=public"
WHATSAPP_NUMERO="59100000000"

# Configuración de Proxy Confiable para extracción segura de IP de cliente
# Opciones:
# - "ninguno" (default): ignora encabezados de proxy (seguro para desarrollo local y servidores directos)
# - "cloudflare": confía exclusivamente en el encabezado `cf-connecting-ip`
# - "railway": confía en el último valor de `x-forwarded-for` o `x-envoy-external-address` inyectado por el Edge Proxy de Railway
PROXY_CONFIABLE="ninguno"

# Cloudflare Turnstile (anti-spam)
# NEXT_PUBLIC_TURNSTILE_SITEKEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
